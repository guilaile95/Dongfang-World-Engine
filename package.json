{
  "name": "dongfang-kuangxiang-world-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "harness:closed-inn": "npm run build && node dist/smoke/closed-inn-harness.js",
    "harness:closed-inn-30": "npm run build && node dist/smoke/closed-inn-30-turn.js",
