    "play": "npm run build && node dist/play.js",
    "smoke:canon-divergence": "npm run build && node dist/smoke/canon-divergence-real-model.js",
    "smoke:canon-narrated": "npm run build && node dist/smoke/canon-divergence-narrated.js",
    "smoke:narrated": "npm run build && node dist/smoke/narrated-smoke.js",
    "smoke:real-model": "npm run build && node dist/smoke/real-model-smoke.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.35",
    "ai": "^7.0.77",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
